@model CartViewModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container py-5 px-4 px-lg-5">
    <div class="mb-4">
        <span class="badge bg-gold-subtle text-gold border border-gold-subtle text-uppercase font-sans small mb-2">ACQUISITION SUMMARY</span>
        <h1 class="h3 font-serif fw-bold text-light mb-1">Vehicle Cart</h1>
        <p class="text-secondary small mb-0">Pre-reserved European single-unit inventory pending secured checkout.</p>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="card-luxury p-5 text-center my-4">
            <i class="bi bi-bag-x fs-1 text-gold mb-3 d-block"></i>
            <h4 class="text-light font-serif">Your cart is currently empty</h4>
            <p class="text-secondary small mb-4">Discover our curated fleet of verified high-performance and luxury automobiles.</p>
            <div>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-gold px-4 py-2">
                    <i class="bi bi-grid me-2"></i> Browse Vehicle Fleet
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Left: Items List -->
            <div class="col-lg-8">
                <div class="card-luxury p-4">
                    <h5 class="font-serif text-light mb-4">Reserved Vehicles (@Model.Items.Count)</h5>

                    @foreach (var item in Model.Items)
                    {
                        <div class="row align-items-center g-3 pb-4 mb-4 border-bottom border-secondary border-opacity-25">
                            <div class="col-md-3">
                                <img src="@item.ImageUrl" alt="@item.Make @item.Model" class="img-fluid rounded border border-secondary border-opacity-25" style="object-fit: cover; aspect-ratio: 16/9; width: 100%;" />
                            </div>
                            <div class="col-md-5">
                                <h6 class="text-light mb-1">
                                    <a asp-controller="Catalog" asp-action="Details" asp-route-vin="@item.CarVin" class="text-light text-decoration-none hover-gold">
                                        @item.Year @item.Make @item.Model
                                    </a>
                                </h6>
                                <div class="text-secondary small font-monospace">VIN: @item.CarVin</div>
                                @if (!item.IsAvailable)
                                {
                                    <span class="badge bg-danger mt-1">Acquired / Sold</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success mt-1">Available in Stock (1 unit)</span>
                                }
                            </div>
                            <div class="col-md-2 text-md-end">
                                <div class="fw-bold text-gold font-sans fs-5">€@item.Price.ToString("N0")</div>
                            </div>
                            <div class="col-md-2 text-md-end">
                                <form asp-controller="Cart" asp-action="Remove" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="vin" value="@item.CarVin" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Remove vehicle">
                                        <i class="bi bi-trash me-1"></i> Remove
                                    </button>
                                </form>
                            </div>
                        </div>
                    }

                    <!-- Delivery Options Selector -->
                    <div class="mt-3">
                        <h6 class="text-gold small text-uppercase tracking-wider fw-bold mb-3">
                            <i class="bi bi-truck me-2"></i> Select Handover &amp; Delivery Method
                        </h6>

                        <form asp-controller="Cart" asp-action="UpdateDelivery" method="post" id="deliveryForm">
                            @Html.AntiForgeryToken()
                            <div class="d-flex flex-column gap-2">
                                <label class="p-3 bg-dark-alt rounded border border-gold-subtle d-flex align-items-center justify-content-between cursor-pointer">
                                    <div class="form-check mb-0">
                                        <input class="form-check-input" type="radio" name="option" value="1" id="deliveryTrailer" @(Model.DeliveryOption == 1 ? "checked" : "") onchange="this.form.submit()" />
                                        <label class="form-check-label text-light fw-medium ms-2" for="deliveryTrailer">
                                            Specialized Enclosed Trailer Delivery
                                            <span class="d-block small text-secondary">Door-to-door fully insured white-glove carrier anywhere in Romania</span>
                                        </label>
                                    </div>
                                    <span class="text-gold font-sans fw-bold">+€490</span>
                                </label>

                                <label class="p-3 bg-dark-alt rounded border border-secondary border-opacity-25 d-flex align-items-center justify-content-between cursor-pointer">
                                    <div class="form-check mb-0">
                                        <input class="form-check-input" type="radio" name="option" value="0" id="deliveryPickup" @(Model.DeliveryOption == 0 ? "checked" : "") onchange="this.form.submit()" />
                                        <label class="form-check-label text-light fw-medium ms-2" for="deliveryPickup">
                                            Bucharest Showroom Handover
                                            <span class="d-block small text-secondary">Private reception &amp; VIP inspection at Calea Floreasca 169A, Bucharest</span>
                                        </label>
                                    </div>
                                    <span class="text-success font-sans fw-bold">FREE (€0)</span>
                                </label>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right: Order Summary -->
            <div class="col-lg-4">
                <div class="card-luxury p-4 sticky-top" style="top: 90px;">
                    <h5 class="font-serif text-light mb-4">Acquisition Total</h5>

                    <div class="d-flex justify-content-between mb-2 small text-secondary">
                        <span>Vehicle Subtotal</span>
                        <span class="text-light font-sans">€@Model.Subtotal.ToString("N0")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 small text-secondary">
                        <span>Delivery &amp; Handover</span>
                        <span class="text-light font-sans">@(Model.DeliveryFee > 0 ? $"€{Model.DeliveryFee:N0}" : "Free (€0)")</span>
                    </div>

                    <div class="d-flex justify-content-between py-3 border-top border-bottom border-gold-subtle mb-4">
                        <span class="fw-bold text-light">Total (VAT incl.)</span>
                        <span class="fw-bold text-gold font-sans fs-4">€@Model.Total.ToString("N0")</span>
                    </div>

                    <div class="d-grid mb-3">
                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-gold py-3 fw-semibold text-uppercase tracking-wider">
                            Proceed to Checkout <i class="bi bi-arrow-right ms-2"></i>
                        </a>
                    </div>

                    <div class="small text-secondary text-center">
                        <i class="bi bi-shield-lock text-gold me-1"></i> Secured Stripe Sandbox Checkout
                    </div>
                </div>
            </div>
        </div>
    }
</div>
