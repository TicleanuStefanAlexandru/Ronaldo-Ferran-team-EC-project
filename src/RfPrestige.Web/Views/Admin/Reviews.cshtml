@model List<SiteReview>
@{
    ViewData["Title"] = "Admin - Reviews";
}

<div class="container-fluid px-4 px-lg-5 py-4">
    <div class="pb-3 mb-4 border-bottom border-gold-subtle">
        <span class="badge bg-danger text-white font-monospace text-uppercase px-2 py-1 mb-1">MODERATION (A9)</span>
        <h1 class="h3 font-serif fw-bold text-light mb-0">Site Reviews Moderation (@Model.Count Testimonials)</h1>
    </div>

    <div class="card-luxury p-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="text-gold small text-uppercase">
                        <th>Client</th>
                        <th>Rating</th>
                        <th>Testimonial Comment</th>
                        <th>Submitted At</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-light">@(r.User != null ? $"{r.User.FirstName} {r.User.LastName}" : "Anonymous")</div>
                                <div class="text-secondary small font-monospace">@(r.User?.Email ?? r.UserId)</div>
                            </td>
                            <td>
                                <span class="text-gold">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star")"></i>
                                    }
                                </span>
                            </td>
                            <td class="small text-secondary" style="max-width: 400px;">"@r.Comment"</td>
                            <td class="small text-secondary font-monospace">@r.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end">
                                <form asp-controller="Admin" asp-action="DeleteReview" method="post" class="d-inline" onsubmit="return confirm('Remove this testimonial?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Remove">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
