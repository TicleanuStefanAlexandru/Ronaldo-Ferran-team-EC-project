@model List<Car>
@{
    ViewData["Title"] = "Admin - Inventory";
}

<div class="container-fluid px-4 px-lg-5 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-4 border-bottom border-gold-subtle gap-3">
        <div>
            <span class="badge bg-danger text-white font-monospace text-uppercase px-2 py-1 mb-1">INVENTORY MANAGEMENT (A9)</span>
            <h1 class="h3 font-serif fw-bold text-light mb-0">Vehicle Fleet Stock (@Model.Count Units)</h1>
        </div>
        <div>
            <a asp-controller="Admin" asp-action="CarEdit" class="btn btn-gold btn-sm px-3 py-2">
                <i class="bi bi-plus-lg me-1"></i> Add New Vehicle
            </a>
        </div>
    </div>

    <div class="card-luxury p-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="text-gold small text-uppercase">
                        <th>Image</th>
                        <th>Vehicle</th>
                        <th>VIN</th>
                        <th>Category</th>
                        <th>Power / Mileage</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var car in Model)
                    {
                        var img = car.Images.FirstOrDefault()?.ImageUrl ?? "/assets/img/default-car.svg";
                        <tr>
                            <td style="width: 70px;">
                                <img src="@img" alt="Car" class="rounded" style="width: 60px; height: 38px; object-fit: cover;" />
                            </td>
                            <td>
                                <div class="fw-bold text-light">@car.Year @car.Make @car.Model</div>
                            </td>
                            <td class="font-monospace small text-secondary">@car.Vin</td>
                            <td><span class="badge bg-dark-alt text-gold border border-gold-subtle">@car.Category</span></td>
                            <td class="small text-secondary">@car.Horsepower HP • @car.Mileage.ToString("N0") km</td>
                            <td class="text-gold fw-bold font-sans">€@car.Price.ToString("N0")</td>
                            <td>
                                @if (car.IsAvailable && car.StockQuantity > 0)
                                {
                                    <span class="badge bg-success text-dark">Available (1 unit)</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger text-white">Sold / 0 Stock</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="Admin" asp-action="CarEdit" asp-route-vin="@car.Vin" class="btn btn-outline-gold btn-sm me-1" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-controller="Admin" asp-action="CarDelete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove this vehicle?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="vin" value="@car.Vin" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
