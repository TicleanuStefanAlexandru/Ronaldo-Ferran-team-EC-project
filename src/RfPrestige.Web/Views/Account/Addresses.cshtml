@model List<Address>
@{
    ViewData["Title"] = "Delivery Addresses";
}

<div class="container py-5 px-4 px-lg-5">
    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            <span class="badge bg-gold-subtle text-gold border border-gold-subtle text-uppercase font-sans small mb-2">CLIENT PROFILE</span>
            <h1 class="h3 font-serif fw-bold text-light mb-1">Saved Romanian Delivery Addresses</h1>
            <p class="text-secondary small mb-0">Manage addresses for enclosed carrier deliveries across Romania.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <button class="btn btn-gold btn-sm px-3 py-2" data-bs-toggle="modal" data-bs-target="#addressModal">
                <i class="bi bi-plus-lg me-1"></i> Add New Address
            </button>
        </div>
    </div>

    <div class="row g-4">
        @if (Model.Count == 0)
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-geo-alt fs-1 text-secondary"></i>
                <h5 class="text-light mt-3">No addresses saved yet</h5>
                <p class="text-secondary small">Add your preferred delivery address for rapid checkout.</p>
            </div>
        }
        else
        {
            @foreach (var addr in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card-luxury p-4 h-100 position-relative @(addr.IsDefault ? "border-gold" : "")">
                        @if (addr.IsDefault)
                        {
                            <span class="badge bg-gold text-dark position-absolute top-0 end-0 m-3 font-monospace">DEFAULT</span>
                        }
                        <div class="fw-bold text-light mb-2"><i class="bi bi-house-door text-gold me-2"></i>@addr.Street</div>
                        <div class="text-secondary small mb-1">@addr.City, @addr.County</div>
                        <div class="text-secondary small font-monospace mb-3">Postal Code: @addr.PostalCode | @addr.Country</div>

                        <div class="d-flex gap-2 pt-3 border-top border-secondary border-opacity-25 mt-auto">
                            @if (!addr.IsDefault)
                            {
                                <form asp-controller="Account" asp-action="SetDefaultAddress" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@addr.Id" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Set as Default</button>
                                </form>
                            }
                            <form asp-controller="Account" asp-action="DeleteAddress" method="post" class="d-inline ms-auto">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@addr.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this address?');">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Modal for New Address -->
<div class="modal fade" id="addressModal" tabindex="-1" aria-labelledby="addressModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-charcoal border-gold text-light">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title font-serif text-gold" id="addressModalLabel">Add Delivery Address</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Account" asp-action="SaveAddress" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-gold small text-uppercase fw-semibold">Street &amp; Number *</label>
                        <input type="text" name="Street" class="form-control" placeholder="Str. Aviatorilor 12, Ap. 4" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-gold small text-uppercase fw-semibold">City *</label>
                            <input type="text" name="City" class="form-control" placeholder="Bucharest" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-gold small text-uppercase fw-semibold">County *</label>
                            <input type="text" name="County" class="form-control" placeholder="București" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-gold small text-uppercase fw-semibold">Postal Code (6 digits) *</label>
                            <input type="text" name="PostalCode" class="form-control" placeholder="011861" pattern="^\d{6}$" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-gold small text-uppercase fw-semibold">Country</label>
                            <input type="text" name="Country" class="form-control" value="Romania" readonly />
                        </div>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsDefault" value="true" id="checkDefault" />
                        <label class="form-check-label small text-secondary" for="checkDefault">
                            Set as default delivery address
                        </label>
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-gold">Save Address</button>
                </div>
            </form>
        </div>
    </div>
</div>
